# ============================================================================
# Connected Vehicle Platform — environment configuration
# Copy this file to `.env` (cp .env.example .env) before running docker compose.
# ============================================================================

# ---- Service ports (host-side) --------------------------------------------
GATEWAY_PORT=8080
INGESTION_PORT=8081
DECODER_PORT=8082
STORAGE_PORT=8083
DIAGNOSTICS_PORT=8084
ANALYTICS_PORT=8085

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=telemetry
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleetpass

# ---- Kafka (KRaft mode, no Zookeeper) --------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_HOST_PORT=9094

# Kafka topic names
TOPIC_RAW_CAN=raw-can-frames
TOPIC_DECODED=decoded-telemetry
TOPIC_ALERTS=diagnostic-alerts

# ---- CAN ingestion ---------------------------------------------------------
# simulator = generate synthetic frames (default, runs anywhere)
# hardware  = read from a real/virtual SocketCAN interface (needs vcan0 on host)
CAN_MODE=simulator
CAN_INTERFACE=vcan0
# Number of simulated vehicles and emit rate (Hz) in simulator mode
SIM_VEHICLE_COUNT=3
SIM_RATE_HZ=10

# ---- Diagnostics tuning ----------------------------------------------------
COOLANT_TEMP_WARN=105
COOLANT_TEMP_CRIT=115
BATTERY_VOLTAGE_MIN=11.8
RPM_MAX=6500
ZSCORE_THRESHOLD=3.0

# ---- Monitoring ------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ---- JVM / Spring ----------------------------------------------------------
SPRING_PROFILES_ACTIVE=docker
